{
	"name": "webext-permission-toggle",
	"version": "7.1.1",
	"description": "Browser-action context menu to request permission for the current tab. Chrome, Firefox, Safari.",
	"license": "MIT",
	"repository": "fregante/webext-permission-toggle",
	"funding": "https://github.com/sponsors/fregante",
	"author": "Federico Brigante <me@fregante.com> (https://fregante.com)",
	"type": "module",
	"exports": {
		"types": "./index.d.ts",
		"default": "./index.js"
	},
	"sideEffects": false,
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "tsc",
		"demo:build": "parcel build --no-cache",
		"demo:watch": "parcel watch --no-cache --no-hmr",
		"docs:watch": "cd docs && npx browser-sync start --server --watch",
		"prepare": "tsc --sourceMap false",
		"test": "xo && tsc --noEmit",
		"watch": "tsc --watch"
	},
	"files": [
		"index.js",
		"index.d.ts"
	],
	"keywords": [
		"browser",
		"chrome",
		"safari",
		"extension",
		"dynamic",
		"register",
		"firefox",
		"permission",
		"ui",
		"webextension"
	],
	"dependencies": {
		"webext-alert": "^1.1.0",
		"webext-content-scripts": "^3.1.0",
		"webext-detect": "^6.1.0",
		"webext-patterns": "^3.0.0",
		"webext-permissions": "^6.0.0",
		"webext-tools": "^4.1.2"
	},
	"devDependencies": {
		"@parcel/config-webextension": "^2.16.4",
		"@parcel/transformer-webextension": "^2.16.4",
		"@sindresorhus/tsconfig": "^9.0.0",
		"@types/chrome": "^0.3.6",
		"globals": "^17.13.0",
		"parcel": "^2.16.4",
		"typescript": "^6.0.3",
		"xo": "^5.0.1"
	},
	"@parcel/resolver-default": {
		"packageExports": true
	},
	"targets": {
		"main": false,
		"mv3": {
			"engines": {
				"browsers": "last 2 Chrome versions"
			},
			"source": "demo/manifest.json",
			"sourceMap": {
				"inline": true
			}
		}
	},
	"webExt": {
		"sourceDir": "dist"
	}
}
